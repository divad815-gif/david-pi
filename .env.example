# Reference compose development settings. The wizard manages production configuration.
# Never commit an actual environment file or keys.
DAVID_PI_IMAGE=david-pi:development
DAVID_PI_DATA_ROOT=/srv/david-pi/data
DAVID_PI_DATA_ID=REPLACE_WITH_INSTALLATION_ID
DAVID_PI_CONFIG_HOST_FILE=/etc/david-pi/installation.json
DAVID_PI_SECRETS_ROOT=/etc/david-pi/secrets
DAVID_PI_PUBLIC_URL=https://john-pi.example-tailnet.ts.net
DAVID_PI_ACCESS_MODE=enforce
MOVIE_REGION=US
TMDB_API_READ_TOKEN=
# Optional independently prepared backup mount. Blank means not configured.
DAVID_PI_SECONDARY_BACKUP_ROOT=
DAVID_PI_SECONDARY_DATA_ID=
DAVID_PI_VAPID_PUBLIC_KEY=
