* text=auto

# Linux entrypoints and service configuration must retain Unix line endings.
david-pi text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.path text eol=lf
*.conf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile text eol=lf

*.bat text eol=crlf
# Keep the Android build input byte-identical in checkouts and source archives
# so its signed exact-source attestation remains reproducible on Linux.
clients/android/gradlew.bat text eol=lf
*.jar binary
*.mp3 binary
*.wasm binary
*.bcmap binary
*.pfb binary
*.ttf binary
