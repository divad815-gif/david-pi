[Unit]
Description=David-Pi household portal
Requires=docker.service srv-data.mount
Wants=david-pi-pihole-summary.service david-pi-backup.service david-pi-server-status.service
After=docker.service tailscaled.service srv-data.mount david-pi-pihole-summary.service david-pi-backup.service david-pi-server-status.service
ConditionPathIsMountPoint=/srv/data
ConditionPathExists=/srv/data/family-photos/.david-pi-storage
ConditionPathIsDirectory=/srv/data/family-photos/audiobooks/originals
ConditionPathExists=/run/david-pi/server-status.json

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/compose/photo-portal
RuntimeDirectory=david-pi-writer-transition
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/sbin/david-pi-portal-lifecycle start
ExecStop=/usr/local/sbin/david-pi-portal-lifecycle stop
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
