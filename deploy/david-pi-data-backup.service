[Unit]
Description=David-Pi independent data snapshot
RequiresMountsFor=/srv/data /srv/backup-data
After=docker.service srv-data.mount srv-backup\\x2ddata.mount
ConditionPathIsMountPoint=/srv/data
ConditionPathIsMountPoint=/srv/backup-data

[Service]
Type=oneshot
RuntimeDirectory=david-pi-data-backup
RuntimeDirectory=david-pi-writer-transition
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/local/sbin/david_pi_backup_quiescence.py recover
ExecStartPre=/usr/local/sbin/david_pi_backup_quiescence.py record-running
ExecStart=/usr/local/sbin/david-pi-data-backup
ExecStopPost=/usr/local/sbin/david_pi_backup_quiescence.py recover
User=root
Group=root
UMask=0077
StateDirectory=david-pi-data-backup
StateDirectoryMode=0700
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/srv/backup-data /run/david-pi-data-backup /run/david-pi-writer-transition /var/lib/david-pi-data-backup
ReadOnlyPaths=/srv/data/family-photos /srv/compose/photo-portal /etc /usr/local/sbin
