[Unit]
Description=David-Pi sanitized Assistant diagnostics
Requires=srv-data.mount
After=srv-data.mount ollama.service
ConditionPathIsMountPoint=/srv/data
ConditionPathExists=/srv/data/family-photos/.david-pi-storage

[Service]
Type=oneshot
ExecStart=/usr/local/lib/david-pi/david-pi-assistant-diagnostics.py
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/data/family-photos/platform/assistant/diagnostics
MemoryMax=64M
TasksMax=16
