[Unit]
Description=Publish aggregate-only Pi-hole statistics for David-Pi
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/david-pi-pihole-summary
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/data/pihole
RuntimeDirectory=david-pi
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/david-pi
