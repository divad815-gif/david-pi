[Unit]
Description=Honor a validated David-Pi safe shutdown request
RequiresMountsFor=/srv/data
After=local-fs.target
ConditionPathIsMountPoint=/srv/data
ConditionPathExists=/srv/data/family-photos/.david-pi-storage

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/david-pi-safe-shutdown
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/data/family-photos/platform/control
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
